DATABASE_URL=
ACCOUNT_ORIGIN=https://mysocialimpact.org
APP_ORIGIN=http://localhost:3000
# Dedicated project key; store only in an ignored local env file or Vercel Secret.
OPENAI_API_KEY=
OPENAI_ORGANIZATION_ID=
OPENAI_PROJECT_ID=
AI_MODEL=openai/gpt-5.4-mini
CRON_SECRET=
REVIEWS_ENABLED=false

# Optional email saving is unavailable until a verified sender is configured.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Voluntary support: off until The Ideas Shed merchant, receipts and real Stripe
# test-mode journey are verified. Never reuse another endpoint's webhook secret.
CONTRIBUTIONS_ENABLED=false
CONTRIBUTIONS_MAX_PENCE=100000
CONTRIBUTIONS_MERCHANT_NAME=
CONTRIBUTIONS_STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional social sign-in. Store real values only as Vercel Secrets.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# A registered, stable preview origin for OAuth callbacks.
AUTH_PREVIEW_ORIGIN=
