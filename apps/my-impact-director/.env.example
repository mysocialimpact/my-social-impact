DATABASE_URL=
ACCOUNT_ORIGIN=https://mysocialimpact.org
APP_ORIGIN=http://localhost:3000
# A project key from your credited OpenAI organisation enables direct OpenAI billing.
# Confirm that organisation’s data controls before enabling this in production.
OPENAI_API_KEY=
# Vercel supplies OIDC in deployment; alternatively use a server-only gateway key.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.4-mini
CRON_SECRET=
REVIEWS_ENABLED=false

# Optional email saving is unavailable until a verified sender is configured.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Voluntary support: off until The Ideas Shed merchant, receipts and real Stripe
# test-mode journey are verified. Never reuse another endpoint's webhook secret.
CONTRIBUTIONS_ENABLED=false
CONTRIBUTIONS_MAX_PENCE=100000
CONTRIBUTIONS_MERCHANT_NAME=
CONTRIBUTIONS_STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
